# Copy this file to .env.development (local work against a non-production
# Supabase project) or .env.production (an explicit, intentional production
# build/export), then fill in real values. Both of those files are
# git-ignored — never commit real Supabase URLs or keys.
#
# Expo automatically loads EXPO_PUBLIC_-prefixed variables from the
# .env.<NODE_ENV> file matching the command you ran: "development" for
# `expo start`, "production" for `expo export` / EAS builds. See
# https://docs.expo.dev/guides/environment-variables/.

# This app's own development/production flag (independent of Expo's
# NODE_ENV). Must be exactly "development" or "production".
APP_ENV=development

# Supabase project URL — Project Settings > API > Project URL.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key — Project Settings > API > anon public key.
# This is the public anon key, not a secret, but it is still specific to one
# Supabase project per environment.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
