# Monorepo root ignores. App-specific rules live in flutter_app/.gitignore
# and react_native_app/.gitignore.

# Miscellaneous
*.log
*.swp
.DS_Store
.history

# Editors / local machine config
.idea/
.obsidian/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Obsidian local device config (vault/ content itself is tracked)
vault/.obsidian/

# Local git worktrees created by isolated agent dispatches
.claude/worktrees/

# Local-only working files that are not part of the repo
_archive/

# Flutter/Dart build output generated at the repo root by a sandbox that
# ran `flutter pub get`/build commands before the flutter_app/ monorepo
# split (2026-10-05) took effect in its checkout. The real app and its own
# equivalent ignores now live under flutter_app/ — these root-level copies
# are stray local artifacts only, never real content.
/.dart_tool/
/.flutter-plugins-dependencies
/android/
/ios/
/linux/
/macos/
/windows/
